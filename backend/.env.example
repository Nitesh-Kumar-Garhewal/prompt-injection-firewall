# Default is SQLite, which works without installing MySQL.
DATABASE_URL=sqlite:///./prompt_firewall.db

# Optional LLM semantic analysis.
# For OpenAI-compatible providers, set the key/base URL/model you use.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=20

MAX_INPUT_CHARS=200000
RISK_BLOCK_THRESHOLD=80
RISK_ESCALATE_THRESHOLD=60
RISK_SANITIZE_THRESHOLD=35
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
